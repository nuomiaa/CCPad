<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="CCPad.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="CC Pad">

    <Grid>
        <Grid x:Name="RootGrid"/>

        <!-- Workspace button — global, top-right, above all split panels -->
        <DropDownButton x:Name="WorkspaceButton"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,7,100,0"
                        Padding="8,4"
                        ToolTipService.ToolTip="工作区"
                        >
            <StackPanel Orientation="Horizontal" Spacing="4">
                <FontIcon Glyph="&#xE8F1;" FontSize="14"/>
                <TextBlock Text="工作区" VerticalAlignment="Center" FontSize="12"/>
            </StackPanel>
            <DropDownButton.Flyout>
                <MenuFlyout x:Name="WorkspaceFlyout" Placement="BottomEdgeAlignedRight"/>
            </DropDownButton.Flyout>
        </DropDownButton>
    </Grid>

</Window>
